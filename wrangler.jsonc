{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-reminder-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8", "AI_TIMEOUT_MS": "12000", "LINE_TIMEOUT_MS": "10000" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-reminder-bot",
      "database_id": "00000000-0000-0000-0000-000000000003"
    }
  ],
  "secrets": {
    "required": ["LINE_CHANNEL_SECRET", "LINE_CHANNEL_ACCESS_TOKEN"]
  }
}
